template <class _Tp>
class optional
    : private __optional_move_assign_base<_Tp>,
      private __sfinae_ctor_base<is_copy_constructible_v<_Tp>, is_move_constructible_v<_Tp>>,
      private __sfinae_assign_base<is_copy_constructible_v<_Tp> && is_copy_assignable_v<_Tp>,
                                   is_move_constructible_v<_Tp> && is_move_assignable_v<_Tp>> {
    static_assert(is_object_v<_Tp>, "instantiation of optional with a non-object type is ill-formed");
    static_assert(!is_array_v<_Tp>, "instantiation of optional with an array type is ill-formed");
    static_assert(!is_same_v<remove_cv_t<_Tp>, in_place_t>, "instantiation of optional with in_place_t is ill-formed");
    static_assert(!is_same_v<remove_cv_t<_Tp>, nullopt_t>, "instantiation of optional with nullopt_t is ill-formed");

    using __base = __optional_move_assign_base<_Tp>;

    template <class _Up>
    friend class optional;

    template <class _Up>
    static constexpr bool __value_constructible_v =
        !is_same_v<remove_cvref_t<_Up>, in_place_t> &&
        !is_same_v<remove_cvref_t<_Up>, optional> &&
        (!is_same_v<remove_cv_t<_Tp>, bool> || !__is_optional_v<remove_cvref_t<_Up>>) &&
        is_constructible_v<_Tp, _Up>;

    template <class _Up, class _Qp>
    static constexpr bool __optional_constructible_v =
        is_constructible_v<_Tp, _Qp> &&
        (is_same_v<remove_cv_t<_Tp>, bool> || !__converts_from_any_cvref_v<_Tp, optional<_Up>>);

    template <class _Up>
    static constexpr bool __value_assignable_v =
        !is_same_v<remove_cvref_t<_Up>, optional> &&
        (!is_scalar_v<_Tp> || !is_same_v<decay_t<_Up>, _Tp>) &&
        is_constructible_v<_Tp, _Up> &&
        is_assignable_v<_Tp&, _Up>;

    template <class _Up, class _Qp>
    static constexpr bool __optional_assignable_v =
        is_constructible_v<_Tp, _Qp> &&
        is_assignable_v<_Tp&, _Qp> &&
        !__converts_from_any_cvref_v<_Tp, optional<_Up>> &&
        !__assignable_from_any_cvref_v<_Tp, optional<_Up>>;

    template <class _Fp, class... _Args>
    _EZCXX_INLINE constexpr explicit optional(__optional_invoke_tag __tag, _Fp&& __f, _Args&&... __args)
        : __base(__tag, std::forward<_Fp>(__f), std::forward<_Args>(__args)...) {}

#if __cplusplus >= 202302L
    template <class _Self, class _Func>
    static constexpr auto __and_then(_Self&& __self, _Func&& __f) {
        using _Up = remove_cvref_t<__invoke_result_t<_Func, decltype(*std::forward<_Self>(__self))>>;
        static_assert(__is_optional_v<_Up>, "the result of f(value()) must be a specialization of std::optional");
        if (__self.has_value()) {
            return _Up(std::__invoke(std::forward<_Func>(__f), *std::forward<_Self>(__self)));
        }
        return _Up();
    }

    template <class _Self, class _Func>
    static constexpr auto __transform(_Self&& __self, _Func&& __f) {
        using _Up = remove_cv_t<__invoke_result_t<_Func, decltype(*std::forward<_Self>(__self))>>;
        static_assert(is_object_v<_Up> && !is_array_v<_Up>, "the result of f(value()) must be a non-array object type");
        static_assert(!is_same_v<_Up, in_place_t> && !is_same_v<_Up, nullopt_t>,
                      "the result of f(value()) must not be in_place_t or nullopt_t");
        if (__self.has_value()) {
            return optional<_Up>(__optional_invoke_tag{}, std::forward<_Func>(__f), *std::forward<_Self>(__self));
        }
        return optional<_Up>();
    }

    template <class _Self, class _Func>
    static constexpr optional __or_else(_Self&& __self, _Func&& __f) {
        static_assert(is_same_v<remove_cvref_t<__invoke_result_t<_Func>>, optional>,
                      "the result of f() must be the same specialization of std::optional");
        if (__self.has_value()) {
            return std::forward<_Self>(__self);
        }
        return std::forward<_Func>(__f)();
    }
#endif // __cplusplus >= 202302L

public:
    using value_type = _Tp;

    _EZCXX_INLINE constexpr optional() noexcept {}

    _EZCXX_INLINE constexpr optional(nullopt_t) noexcept {}

    constexpr optional(const optional&) = default;

    constexpr optional(optional&&) = default;

    template <class... _Args, enable_if_t<is_constructible_v<_Tp, _Args...>, int> = 0>
    _EZCXX_INLINE constexpr explicit optional(in_place_t, _Args&&... __args)
        : __base(in_place, std::forward<_Args>(__args)...) {}

    template <class _Up, class... _Args,
              enable_if_t<is_constructible_v<_Tp, initializer_list<_Up>&, _Args...>, int> = 0>
    _EZCXX_INLINE constexpr explicit optional(in_place_t, initializer_list<_Up> __il, _Args&&... __args)
        : __base(in_place, __il, std::forward<_Args>(__args)...) {}

    template <class _Up = remove_cv_t<_Tp>, enable_if_t<__value_constructible_v<_Up>, int> = 0>
    _EZCXX_INLINE constexpr explicit(!is_convertible_v<_Up, _Tp>) optional(_Up&& __v)
        : __base(in_place, std::forward<_Up>(__v)) {}

