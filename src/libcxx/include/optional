    template <class _Up, enable_if_t<__optional_constructible_v<_Up, _Up>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 explicit(!is_convertible_v<_Up, _Tp>) optional(optional<_Up>&& __v) {
        this->__construct_from(std::move(__v));
    }

    _EZCXX_CONSTEXPR_SINCE_CXX20 optional& operator=(nullopt_t) noexcept {
        reset();
        return *this;
    }

    constexpr optional& operator=(const optional&) = default;

    constexpr optional& operator=(optional&&) = default;

    template <class _Up = remove_cv_t<_Tp>, enable_if_t<__value_assignable_v<_Up>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 optional& operator=(_Up&& __v) {
        if (this->has_value()) {
            this->__val_ = std::forward<_Up>(__v);
        } else {
