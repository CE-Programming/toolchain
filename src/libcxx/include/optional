//------------------------------------------------------------------------------
// comparisons
//------------------------------------------------------------------------------

#define _EZCXX_OPTIONAL_RESULT(__op, __lhs, __rhs) \
    enable_if_t<is_convertible_v<decltype(std::declval<const __lhs&>() __op std::declval<const __rhs&>()), bool>, bool>

template <class _Tp, class _Up>
constexpr _EZCXX_OPTIONAL_RESULT(==, _Tp, _Up) operator==(const optional<_Tp>& __x, const optional<_Up>& __y) {
    if (__x.has_value() != __y.has_value()) {
        return false;
    }
    return !__x.has_value() || *__x == *__y;
}

template <class _Tp, class _Up>
constexpr _EZCXX_OPTIONAL_RESULT(!=, _Tp, _Up) operator!=(const optional<_Tp>& __x, const optional<_Up>& __y) {
    if (__x.has_value() != __y.has_value()) {
        return true;
    }
    return __x.has_value() && *__x != *__y;
}

template <class _Tp, class _Up>
constexpr _EZCXX_OPTIONAL_RESULT(<, _Tp, _Up) operator<(const optional<_Tp>& __x, const optional<_Up>& __y) {
    if (!__y.has_value()) {
        return false;
    }
    return !__x.has_value() || *__x < *__y;
}

template <class _Tp, class _Up>
constexpr _EZCXX_OPTIONAL_RESULT(>, _Tp, _Up) operator>(const optional<_Tp>& __x, const optional<_Up>& __y) {
    if (!__x.has_value()) {
        return false;
    }
    return !__y.has_value() || *__x > *__y;
}

template <class _Tp, class _Up>
