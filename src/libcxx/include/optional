    _EZCXX_CONSTEXPR_SINCE_CXX20 void swap(optional& __opt)
    noexcept(is_nothrow_move_constructible_v<_Tp> && is_nothrow_swappable_v<_Tp>) {
        if (this->has_value() == __opt.has_value()) {
            if (this->has_value()) {
                using std::swap;
                swap(this->__val_, __opt.__val_);
            }
        } else if (this->has_value()) {
            __opt.__construct(std::move(this->__val_));
            reset();
        } else {
            this->__construct(std::move(__opt.__val_));
            __opt.reset();
