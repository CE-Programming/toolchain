        }
        return *this;
    }

    template <class _Up, enable_if_t<__optional_assignable_v<_Up, const _Up&>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 optional& operator=(const optional<_Up>& __v) {
        this->__assign_from(__v);
        return *this;
    }

    template <class _Up, enable_if_t<__optional_assignable_v<_Up, _Up>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 optional& operator=(optional<_Up>&& __v) {
        this->__assign_from(std::move(__v));
        return *this;
    }

    template <class... _Args, enable_if_t<is_constructible_v<_Tp, _Args...>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 _Tp& emplace(_Args&&... __args) {
        reset();
        this->__construct(std::forward<_Args>(__args)...);
        return this->__val_;
    }

    template <class _Up, class... _Args,
              enable_if_t<is_constructible_v<_Tp, initializer_list<_Up>&, _Args...>, int> = 0>
    _EZCXX_CONSTEXPR_SINCE_CXX20 _Tp& emplace(initializer_list<_Up> __il, _Args&&... __args) {
        reset();
