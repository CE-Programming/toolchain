    _EZCXX_INLINE constexpr const _Tp* operator->() const noexcept { return std::addressof(this->__val_); }

    _EZCXX_INLINE constexpr _Tp* operator->() noexcept { return std::addressof(this->__val_); }

    using __base::operator*;

    using __base::has_value;

    using __base::reset;

    _EZCXX_INLINE constexpr explicit operator bool() const noexcept { return this->has_value(); }

