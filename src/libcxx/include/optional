        : __val_(std::__invoke(std::forward<_Fp>(__f), std::forward<_Args>(__args)...)), __engaged_(true) {}

    _EZCXX_INLINE constexpr void reset() noexcept {
        __engaged_ = false;
    }
};

template <class _Tp>
struct __optional_storage_base : __optional_destruct_base<_Tp> {
    using __optional_destruct_base<_Tp>::__optional_destruct_base;

    _EZCXX_INLINE constexpr bool has_value() const noexcept { return this->__engaged_; }

    _EZCXX_INLINE constexpr _Tp& operator*() & noexcept { return this->__val_; }

    _EZCXX_INLINE constexpr const _Tp& operator*() const& noexcept { return this->__val_; }

    _EZCXX_INLINE constexpr _Tp&& operator*() && noexcept { return std::move(this->__val_); }

    _EZCXX_INLINE constexpr const _Tp&& operator*() const&& noexcept { return std::move(this->__val_); }

    template <class... _Args>
    _EZCXX_CONSTEXPR_SINCE_CXX20 void __construct(_Args&&... __args) {
        std::__construct_at(std::addressof(this->__val_), std::forward<_Args>(__args)...);
        this->__engaged_ = true;
    }

    template <class _That>
    _EZCXX_CONSTEXPR_SINCE_CXX20 void __construct_from(_That&& __opt) {
        if (__opt.has_value()) {
            __construct(*std::forward<_That>(__opt));
        }
    }

    template <class _That>
    _EZCXX_CONSTEXPR_SINCE_CXX20 void __assign_from(_That&& __opt) {
        if (this->__engaged_ == __opt.has_value()) {
            if (this->__engaged_) {
                this->__val_ = *std::forward<_That>(__opt);
            }
        } else if (this->__engaged_) {
            this->reset();
        } else {
            __construct(*std::forward<_That>(__opt));
        }
    }
};

