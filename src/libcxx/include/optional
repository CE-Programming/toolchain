template <class _Tp, bool = is_trivially_destructible_v<_Tp>>
struct __optional_destruct_base {
    using __value_type = remove_cv_t<_Tp>;

    union {
        char __null_state_;
        __value_type __val_;
    };
    bool __engaged_;

    _EZCXX_CONSTEXPR_SINCE_CXX20 ~__optional_destruct_base() {
        if (__engaged_) {
            __val_.~__value_type();
        }
    }

    _EZCXX_INLINE constexpr __optional_destruct_base() noexcept : __null_state_(), __engaged_(false) {}

    template <class... _Args>
    _EZCXX_INLINE constexpr explicit __optional_destruct_base(in_place_t, _Args&&... __args)
        : __val_(std::forward<_Args>(__args)...), __engaged_(true) {}

    template <class _Fp, class... _Args>
    _EZCXX_INLINE constexpr __optional_destruct_base(__optional_invoke_tag, _Fp&& __f, _Args&&... __args)
        : __val_(std::__invoke(std::forward<_Fp>(__f), std::forward<_Args>(__args)...)), __engaged_(true) {}

    _EZCXX_CONSTEXPR_SINCE_CXX20 void reset() noexcept {
        if (__engaged_) {
            __val_.~__value_type();
            __engaged_ = false;
        }
    }
};

template <class _Tp>
struct __optional_destruct_base<_Tp, true> {
    using __value_type = remove_cv_t<_Tp>;

    union {
        char __null_state_;
        __value_type __val_;
    };
    bool __engaged_;

    _EZCXX_INLINE constexpr __optional_destruct_base() noexcept : __null_state_(), __engaged_(false) {}

    template <class... _Args>
    _EZCXX_INLINE constexpr explicit __optional_destruct_base(in_place_t, _Args&&... __args)
        : __val_(std::forward<_Args>(__args)...), __engaged_(true) {}

    template <class _Fp, class... _Args>
